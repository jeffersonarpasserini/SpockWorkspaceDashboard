WORKSPACE_ROOT=/workspace
HERMES_BIN=hermes
HERMES_BOARD_MAP={"QualitasSystem":"default"}
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Spock PostgreSQL. Use a dedicated database/user; never reuse Agent Orchestrator or Honcho roles.
SPOCK_DATABASE_URL=postgresql://spock_dashboard:change-me@127.0.0.1:55432/spock_dashboard
SPOCK_DB_NAME=spock_dashboard
SPOCK_DB_USER=spock_dashboard
SPOCK_DB_PASSWORD=change-me
SPOCK_PROJECT_CATALOG_MODE=legacy
SPOCK_WORKSPACE_SLUG=local-workspace
